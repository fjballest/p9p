#!/usr/local/plan9/bin/rc
# start name: run acme using profile $home/lib/acmeapp/name,
# in its own namespace, with its own dump, plumber and fontsrv.
# Based on nemo's /u/rcbin/a.
#
# A profile may set (all optional):
#	NAMESPACE	namespace dir (default /tmp/$user.ns.name)
#	DUMP		dump file loaded at start and used by Dump and Load
#			(default $home/acme.dump.name)
#			Both may be lists: the first namespace without a
#			running acme is used, along with the matching dump.
#	font		font for acme (-f and -F)
#	altfont		fixed width font (-F), defaults to $font
#	acmeflags	flags for acme (default -a)
#	tabstop, prompt, acmeshell ...: anything else acme should see

ifs='
'
name=$1
dir=$home/lib/acmeapp
if(~ $#user 0)
	user=$USER
if(~ $#user 0)
	user=`{id -un}
path=(/usr/bin /bin /usr/sbin /sbin $PLAN9/bin)
if(test -f $dir/env)
	. $dir/env

NAMESPACE=/tmp/$user.ns.$name
DUMP=$home/acme.dump.$name
font=()
altfont=()
acmeflags=-a
tabstop=4
prompt=('; ' '	')
SHELL=$PLAN9/bin/rc
if(test -x /bin/rc)
	SHELL=/bin/rc
. $dir/$name
shell=$SHELL
if(~ $#acmeshell 0)
	acmeshell=$SHELL
if(~ $#altfont 0)
	altfont=$font

fn running {
	NAMESPACE=$1 9p stat acme >/dev/null >[2=1]
}

fn popdump {
	d=$1
	if(! ~ $#* 1)
		shift
	dumps=($*)
}

dumps=($DUMP)
ns=()
for(n in $NAMESPACE){
	if(~ $#ns 0){
		popdump $dumps
		if(! running $n){
			ns=$n
			DUMP=$d
		}
	}
}
if(~ $#ns 0){
	9menu -l Acme 'acme '^$name^' is already running' >/dev/null
	exit running
}
NAMESPACE=$ns
acmedump=$DUMP

mkdir -p $NAMESPACE
chmod 700 $NAMESPACE
rm -f $NAMESPACE/*

plumbpid=()
if(! 9p stat plumb >/dev/null >[2=1]){
	plumber -f &
	plumbpid=$apid
}
fontpid=()
if(! 9p stat font >/dev/null >[2=1]){
	fontsrv &
	fontpid=$apid
}

arch=x86_64
if(arch -arch arm64 true >/dev/null >[2=1])
	arch=arm64
args=($acmeflags)
if(! ~ $#font 0)
	args=($args -f $font)
if(! ~ $#altfont 0)
	args=($args -F $altfont)
if(test -e $DUMP)
	args=($args -l $DUMP)
echo acme $args NAMESPACE'='$NAMESPACE acmedump'='$acmedump >[1=2]
arch -arch $arch $PLAN9/bin/acme $args

if(! ~ $#plumbpid 0)
	kill $plumbpid
if(! ~ $#fontpid 0)
	kill $fontpid
sleep 1
rm -f $NAMESPACE/*
exit ''
