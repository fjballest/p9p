#!/usr/local/plan9/bin/rc
# start name: run acme using profile $home/lib/acmeapp/name,
# in its own namespace, with its own dump, plumber and fontsrv.
# Based on nemo's /u/rcbin/a.
#
# A profile may set (all optional):
#	NAMESPACE	namespace dir (default /tmp/$user.ns.name)
#	DUMP		dump file loaded at start and used by Dump and Load
#			(default $home/acme.dump.name)
#			Both may be lists: the first namespace without a
#			running acme is used, along with the matching dump.
#	font		font for acme (-f and -F)
#	altfont		fixed width font (-F), defaults to $font
#	acmeflags	flags for acme (default -a)
#	acmeprog	program to run (default acme; e.g. macme)
#	tabstop, prompt, acmeshell ...: anything else acme should see

ifs='
'
name=$1
dir=$home/lib/acmeapp
if(~ $#user 0)
	user=$USER
if(~ $#user 0)
	user=`{id -un}
path=(/usr/bin /bin /usr/sbin /sbin $PLAN9/bin)
if(test -f $dir/env)
	. $dir/env

NAMESPACE=/tmp/$user.ns.$name
DUMP=$home/acme.dump.$name
font=()
altfont=()
acmeflags=-a
acmeprog=acme
tabstop=4
prompt=('; ' '	')
SHELL=$PLAN9/bin/rc
if(test -x /bin/rc)
	SHELL=/bin/rc
. $dir/$name
shell=$SHELL
if(~ $#acmeshell 0)
	acmeshell=$SHELL
if(~ $#altfont 0)
	altfont=$font

fn running {
	NAMESPACE=$1 9p stat acme >/dev/null >[2=1]
}

fn popdump {
	d=$1
	if(! ~ $#* 1)
		shift
	dumps=($*)
}

dumps=($DUMP)
ns=()
for(n in $NAMESPACE){
	if(~ $#ns 0){
		popdump $dumps
		if(! running $n){
			ns=$n
			DUMP=$d
		}
	}
}
if(~ $#ns 0){
	9menu -l Acme $name^' already running' >/dev/null
	exit running
}
NAMESPACE=$ns
acmedump=$DUMP

# pids of processes with unix sockets in $NAMESPACE:
# plumber, fontsrv, acme's 9pserve and the like
fn nsprocs {
	lsof -U -F pn >[2]/dev/null | awk -v 'ns='^$NAMESPACE^'/' -v 'me='^$pid '
		/^p/ { p = substr($0, 2) }
		/^n/ && index(substr($0, 2), ns) == 1 && p != me { print p }
	' | sort -u
}

fn cleanup {
	pids=($plumbpid $fontpid)
	for(p in $pids)
		pids=($pids `{pgrep -P $p})	# e.g., the 9pserve of plumber
	pids=($pids `{nsprocs})
	if(! ~ $#pids 0){
		echo $name: killing $pids >[1=2]
		kill $pids >[2]/dev/null
		sleep 1
	}
	rm -f $NAMESPACE/*
}

# also clean up if we are told to quit (e.g., at logout)
fn sighup {
	cleanup
	exit hangup
}
fn sigterm {
	cleanup
	exit term
}

mkdir -p $NAMESPACE
chmod 700 $NAMESPACE
# leftovers from an acme that did not clean up
plumbpid=()
fontpid=()
cleanup

if(! 9p stat plumb >/dev/null >[2=1]){
	plumber -f &
	plumbpid=$apid
}
if(! 9p stat font >/dev/null >[2=1]){
	fontsrv &
	fontpid=$apid
}

arch=x86_64
if(arch -arch arm64 true >/dev/null >[2=1])
	arch=arm64
args=($acmeflags)
if(! ~ $#font 0)
	args=($args -f $font)
if(! ~ $#altfont 0)
	args=($args -F $altfont)
if(test -e $DUMP)
	args=($args -l $DUMP)
echo $acmeprog $args NAMESPACE'='$NAMESPACE acmedump'='$acmedump >[1=2]
arch -arch $arch $PLAN9/bin/$acmeprog $args
cleanup
exit ''
