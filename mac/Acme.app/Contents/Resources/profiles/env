# Read (by rc) before any profile. Finder starts apps with a
# minimal PATH; set the one acme and its commands should see.
path=(/opt/local/bin /opt/local/sbin /u/rcbin /u/bin $home/bin /usr/local/go/bin /usr/local/bin /usr/bin /bin /usr/sbin /sbin /Library/TeX/texbin /opt/ImageMagick/bin $PLAN9/bin)
JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-11.0.17.jdk/Contents/Home
path=($JAVA_HOME/bin $path)
# font for the Acme.app menus
menufont=/mnt/font/Consolas-Bold/14a/font
