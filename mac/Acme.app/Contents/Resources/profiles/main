# The usual full screen acme, like /u/rcbin/a with no arguments.
# Up to four of them, each with its own namespace and dump.
NAMESPACE=(/tmp/$user.ns.0 /tmp/$user.ns.1 /tmp/$user.ns.2 /tmp/$user.ns.3)
DUMP=($home/acme.dump $home/acme.dump.1 $home/acme.dump.2 $home/acme.dump.3)
font=/mnt/font/Consolas-Bold/14a/font
