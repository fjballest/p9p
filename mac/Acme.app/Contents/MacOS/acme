#!/bin/sh
# Acme.app: ask which kind of acme to start, then start it
# in its own namespace with its own dump file.
#
# Each kind is a profile, a small sh file in $HOME/lib/acmeapp
# (see Contents/Resources/profiles for examples; they are copied
# there the first time the app runs). The file name is the name
# shown in the menu. $HOME/lib/acmeapp/env, if present, is read
# before any profile and is the place for PATH and the like.
# The menu can also create a new acme (asking for its name and
# font) or remove some (their files go to $HOME/lib/acmeapp/.removed).

app=$(cd "$(dirname "$0")/.." && pwd)
log=/tmp/acmeapp.$(id -un).log
exec 2>>"$log"
# The app lives in $PLAN9/mac/Acme.app; prefer that over the
# path INSTALL writes here, so it works before INSTALL is rerun.
PLAN9=${PLAN9:-/usr/local/plan9}
p9=$(cd "$app/../../.." && pwd)
[ -x "$p9/bin/acme" ] && PLAN9=$p9
export PLAN9
dir=$HOME/lib/acmeapp
echo "$(date): Acme.app PLAN9=$PLAN9" >&2

if [ ! -d "$dir" ]; then
	mkdir -p "$dir"
	cp "$app/Resources/profiles/"* "$dir/"
fi

New="New acme..."
Remove="Remove acmes..."

# osa script-lines...: run AppleScript, print its result.
# Exits 1 on cancel. Falls back to System Events when this
# process is not allowed to show dialogs itself.
osa() {
	err=$(mktemp /tmp/acmeapp.XXXXXX)
	if ! out=$(osascript "$@" 2>"$err"); then
		if grep -q -- '-128' "$err"; then
			rm -f "$err"; return 1
		fi
		cat "$err" >&2
		if ! out=$(osascript -e 'tell application "System Events"' -e activate "$@" -e 'end tell' 2>"$err"); then
			cat "$err" >&2; rm -f "$err"; return 1
		fi
	fi
	rm -f "$err"
	echo "$out"
}

alist() {	# alist words...: AppleScript list
	for w in "$@"; do printf '"%s"\n' "$w"; done | paste -sd, -
}

profiles() {
	(cd "$dir" && ls | grep -v -e '^env$' -e '\.' -e '~$')
}

newacme() {
	n=$(osa -e 'text returned of (display dialog "Name for the new acme:" with title "Acme" default answer "")') || return 1
	case "$n" in
	""|env|*[!A-Za-z0-9_-]*)
		osa -e "display alert \"Acme\" message \"Use letters, digits, - and _ for the name.\"" >/dev/null
		return 1
	esac
	if [ -e "$dir/$n" ]; then
		echo "$n"
		return 0
	fi
	f=$(sed -n 's/^font=//p' "$dir/${last:-main}" 2>/dev/null | sed 1q)
	f=${f:-/mnt/font/Consolas-Bold/14a/font}
	f=$(osa -e "text returned of (display dialog \"Font for acme $n:\" with title \"Acme\" default answer \"$f\")") || return 1
	{
		echo "# Created by Acme.app on $(date '+%Y-%m-%d')."
		echo "# NAMESPACE and DUMP default to /tmp/\$USER.ns.$n and \$HOME/acme.dump.$n"
		echo "font=$f"
	} >"$dir/$n"
	echo "$n"
}

rmacmes() {
	set -- $(profiles)
	[ $# -eq 0 ] && return
	sel=$(osa -e "choose from list {$(alist "$@")} with title \"Acme\" with prompt \"Remove which acmes? (their dump files are kept)\" with multiple selections allowed") || return
	[ "$sel" = false ] && return
	names=$(echo "$sel" | sed 's/, /,/g' | tr , '\n')
	osa -e "display dialog \"Remove $(echo $names)?\" with title \"Acme\" buttons {\"Cancel\", \"Remove\"} default button \"Cancel\"" >/dev/null || return
	for n in $names; do
		echo "removing profile $n" >&2
		mkdir -p "$dir/.removed"
		mv "$dir/$n" "$dir/.removed/$n"
	done
}

while :; do
	last=$(cat "$dir/.last" 2>/dev/null)
	ps=$(profiles)
	echo "$ps" | grep -qx "$last" || last=main
	echo "$ps" | grep -qx "$last" || last=$(echo "$ps" | sed 1q)
	[ -z "$last" ] && last=$New
	name=$(osa -e "choose from list {$(alist $ps "$New" "$Remove")} with title \"Acme\" with prompt \"Start which acme?\" default items {\"$last\"}") || exit 0
	case "$name" in
	""|false)
		exit 0
		;;
	"$Remove")
		rmacmes
		continue
		;;
	"$New")
		name=$(newacme) || continue
		;;
	esac
	break
done
echo "$name" >"$dir/.last"

echo "starting $name" >&2
"$app/Resources/start" "$name" </dev/null >>"$log" 2>&1 &
exit 0
