#!/bin/sh
# Acme.app: find $PLAN9 and run the real program, an rc script,
# with stderr going to /tmp/acmeapp.$USER.log.
app=$(cd "$(dirname "$0")/.." && pwd)
# The app lives in $PLAN9/mac/Acme.app; prefer that over the
# path INSTALL writes here, so it works before INSTALL is rerun.
PLAN9=${PLAN9:-/usr/local/plan9}
p9=$(cd "$app/../../.." && pwd)
[ -x "$p9/bin/rc" ] && PLAN9=$p9
export PLAN9
exec "$PLAN9/bin/rc" "$app/Resources/acmeapp" "$app" 2>>/tmp/acmeapp.$(id -un).log
