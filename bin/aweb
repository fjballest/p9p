#!/usr/local/plan9/bin/rc
# aweb [-h height] url - show a web page in a macme window.
# The page is rendered as an image with a headless Chrome
# (or Chromium, or Firefox), as wide as the window.
# Clicking on a link follows it (button 2 opens a new window);
# Links opens a window listing the page links (plumb them);
# button 2 on a URL in the tag goes there; Back goes back;
# Reload renders again; Zoom+ and Zoom- scale the page;
# More renders more of the page.
# With chrome, cookies are kept in $home/lib/aweb/cookies;
# Login (or aweb -l) opens the page in a Chrome window to log
# in there; Reload once logged in.
. $PLAN9/lib/acme.rc
ifs=' 	
'
path=($path /opt/local/bin /opt/homebrew/bin /usr/local/bin)

height=4000
login=()
while(~ $1 -*){
	switch($1){
	case -h
		height=$2
		shift
	case -l
		login=yes
	case *
		echo 'usage: aweb [-l] [-h height] url' >[1=2]
		exit usage
	}
	shift
}
if(! ~ $#* 1){
	echo 'usage: aweb [-l] [-h height] url' >[1=2]
	exit usage
}
url=$1
switch($url){
case *://*
	;
case /*
	url=file://$url
case *
	if(test -e $url)
		url=file://`{pwd}^/$url
	if not
		url=https://$url
}
hist=()
zoom=100
tmp=/tmp/aweb.$pid
if(~ $#user 0)
	user=$USER
if(~ $#user 0)
	user=`{id -un}

fn has {
	~ `{ls $path^/$1 >[2]/dev/null} ?*
}

# the browser and how to run it
mac='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'
chrome=()
if(~ $#browser 1)
	chrome=$browser
if not if(test -x $mac)
	chrome=$mac
if not for(b in google-chrome chromium chromium-browser){
	if(~ $#chrome 0 && has $b)
		chrome=$b
}
firefox=()
if(~ $#chrome 0){
	if(test -x /Applications/Firefox.app/Contents/MacOS/firefox)
		firefox=/Applications/Firefox.app/Contents/MacOS/firefox
	if not if(has firefox)
		firefox=firefox
	if not{
		echo aweb: no chrome, chromium, or firefox >[1=2]
		exit browser
	}
}

# chrome runs through awebcdp, which keeps the cookies
# (so logins last) and records the link boxes; pages that take
# long to load are shown as they are after $wait ms.
wait=15000
cookies=()
if(~ $#chrome 1){
	if(~ $#home 0)
		home=$HOME
	cookies=$home/lib/aweb/cookies
	mkdir -p $home/lib/aweb
}

# open $url in a Chrome window, to log in there
fn login {
	if(~ $#chrome 1)
		AWEBCHROME=$chrome awebcdp -l -c $cookies $url >[2]/dev/null &
}

# window width in pixels
fn width {
	w=`{winread image | awk '{print $1}'}
	if(! ~ $w [1-9]*)
		w=800
	echo $w
}

# render $url as wide as the window; with chrome, also
# record the link boxes in $tmp.boxes
fn render {
	rm -f $tmp.png $tmp.boxes $tmp.err
	w=`{width}
	if(~ $#chrome 1){
		s=`{echo $zoom | awk '{print $1/100}'}
		cw=`{echo $w $zoom | awk '{print int($1*100/$2)}'}
		ch=`{echo $height $zoom | awk '{print int($1*100/$2)}'}
		# awebcdp keeps a chrome running for this window
		# (until aweb is gone, or it is idle for a while), so
		# that clicks do not wait for one to start each time
		u=`{AWEBCHROME=$chrome awebcdp -C $tmp.sock -P $pid -c $cookies -s $s -w $wait \
			-W $cw -H $ch -o $tmp.png -b $tmp.boxes $url >[2]$tmp.err}
		# where redirections took us
		if(~ $#u 1 && test -s $tmp.png)
			url=$u
	}
	if not
		$firefox --headless --window-size'='$w,$height --screenshot $tmp.png $url >/dev/null >[2]$tmp.err
	if(! test -s $tmp.png){
		echo aweb: $url: cannot render >[1=2]
		tail -5 $tmp.err >[1=2]
		status=render
	}
	if not{
		png -t $tmp.png | winwrite image
		rm -f $tmp.png
		winname $url
		# so Dump and Load bring the window back as it is
		winctl dump aweb -h $height $url
		status=''
	}
}

# the link at $1 $2 (image pixels), if any
fn linkat {
	if(test -s $tmp.boxes)
		awk -v 'x='$1 -v 'y='$2 -v 'z='$zoom '
		BEGIN { x = x*100/z; y = y*100/z }
		$1 <= x && x < $3 && $2 <= y && y < $4 {
			a = ($3-$1)*($4-$2)
			if(best == "" || a < besta){
				l = $0
				sub(/^[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ +/, "", l)
				best = l
				besta = a
			}
		}
		END { if(best != "") print best }' $tmp.boxes
}

fn go {
	hist=($url $hist)
	url=$1
	if(! render){
		url=$hist(1)
		hist=$hist(2-)
	}
}

# the links in the page, made absolute, one per line
fn links {
	if(test -s $tmp.boxes)
		awk '{ print "href=\"" $5 "\"" }' $tmp.boxes
	if not
		curl -sL $url
}

fn showlinks {
	links | awk -v 'url='$url '
	function abs(l,   b) {
		if(l ~ /^[a-zA-Z]+:/)
			return l
		match(url, /^[a-zA-Z]+:\/\/[^\/]*/)
		b = substr(url, 1, RLENGTH)
		if(l ~ /^\/\//)
			return substr(url, 1, index(url, ":")) l
		if(l ~ /^\//)
			return b l
		b = url
		sub(/[?#].*/, "", b)
		sub(/[^\/]*$/, "", b)
		return b l
	}
	{
		s = $0
		while(match(s, /[hH][rR][eE][fF]="[^"]*"/)){
			l = substr(s, RSTART+6, RLENGTH-7)
			s = substr(s, RSTART+RLENGTH)
			if(l == "" || l ~ /^#/ || l ~ /^javascript:/)
				continue
			gsub(/&amp;/, "\\&", l)
			l = abs(l)
			if(!(l in seen)){
				seen[l] = 1
				print l
			}
		}
	}' > $tmp.links
	{
		id=$winid
		newwindow
		winname $url^'+links'
		winwrite body < $tmp.links
		winctl clean
		winid=$id
	}
	rm -f $tmp.links
}

fn event {
	# F events are our own changes to the tag and body
	if(~ $1 F)
		status=''
	if not switch($2){
	case x X
		switch($9){
		case Back
			if(! ~ $#hist 0){
				url=$hist(1)
				hist=$hist(2-)
				render
			}
		case Reload
			render
		case Login
			login
		case Links
			showlinks
		case More
			height=`{expr $height '*' 2}
			render
		case Zoom+
			zoom=`{expr $zoom '*' 5 / 4}
			render
		case Zoom-
			if(! ~ $zoom [0-9] [1-3][0-9]){
				zoom=`{expr $zoom '*' 4 / 5}
				render
			}
		case *://*
			go $9
		case *
			winwriteevent $*
		}
	case I
		# a click on the page: B1 or B3 follows a link,
		# B2 opens it in a new window
		l=`{linkat $3 $4}
		if(! ~ $#l 0){
			if(~ $9 2){
				aweb -h $height $l &
			}
			if not
				go $l
		}
	case *
		winwriteevent $*
	}
}

newwindow
winname $url
winctl dumpdir /
tag=' Back Reload Links More Zoom+ Zoom- '
if(~ $#chrome 1)
	tag=$tag^'Login '
echo -n $tag | winwrite tag
winctl clean
if(~ $login yes)
	login
if(! render){
	# keep the window, to show why
	{ echo aweb: $url: cannot render; cat $tmp.err } | winwrite body
	winctl clean
}
wineventloop
rm -f $tmp.png $tmp.boxes $tmp.err $tmp.sock
