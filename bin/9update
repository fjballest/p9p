#!/usr/local/plan9/bin/rc
# 9update [-n] [pr...] - update this plan9port tree and rebuild
# what changed.
#	pr...	merge these pull requests first (needs gh)
#	-n	just tell what would be done
# Local copies of files that only differ by INSTALL's path
# rewrite (/usr/local/plan9 -> $PLAN9) are restored before
# pulling and rewritten again afterwards; other local changes
# make it stop. If libraries or headers changed, all commands
# are relinked (mk does not notice library changes).
ifs=' 	
'
flagn=()
if(~ $1 -n){
	flagn=1
	shift
}
cd $PLAN9 || exit nodir
log=/tmp/9update.$pid.log

fn run {
	echo '>' $* >[1=2]
	if(~ $#flagn 0)
		$*
	if not
		status=''
}

# build dir target...
fn build {
	echo '>' cd $1 '&&' mk $*(2-) >[1=2]
	if(~ $#flagn 0)
		@{cd $1 && mk $*(2-)}
	if not
		status=''
}

fn fail {
	echo 9update: $* >[1=2]
	exit fail
}

# merge pull requests
for(pr){
	if(! ~ `{ls /opt/homebrew/bin/gh /usr/local/bin/gh /opt/local/bin/gh `{echo $path^/gh} >[2]/dev/null} ?*)
		fail no gh: merge PR $pr on GitHub and run 9update again
	run gh pr merge $pr --merge
}

# set aside INSTALL's path rewrites
rewritten=()
for(f in `{git diff --name-only}){
	git show HEAD:$f >[2]/dev/null | sed 's,/usr/local/plan9,'$PLAN9',g' >$log
	if(cmp -s $log $f)
		rewritten=($rewritten $f)
	if not
		fail $f has local changes: commit or undo them first
}
old=`{git rev-parse HEAD}
git fetch -q origin master || fail git fetch failed
new=`{git rev-parse FETCH_HEAD}
if(~ $old $new){
	echo 9update: up to date
	exit ''
}
if(! ~ $#rewritten 0)
	run git checkout -- $rewritten
run git merge -q --ff-only $new || fail cannot fast-forward to origin/master
if(! ~ $#rewritten 0 && ~ $#flagn 0)
	for(f in $rewritten)
		sed 's,/usr/local/plan9,'$PLAN9',g' $f > $f.9u && cat $f.9u > $f && rm -f $f.9u
changed=`{git diff --name-only $old $new}
echo changed: $changed >[1=2]

# what to build
libs=()
all=()
cmds=()
for(f in $changed){
	switch($f){
	case include/* src/mkhdr src/mkone src/mkmany src/mklib src/mkcommon
		all=1
	case src/lib*/*
		l=`{echo $f | awk -F/ '{print $1 "/" $2}'}
		if(! ~ $l $libs)
			libs=($libs $l)
		all=1
	case src/cmd/*/*
		d=`{echo $f | awk -F/ '{print $1 "/" $2 "/" $3}'}
		if(! ~ $d $cmds)
			cmds=($cmds $d)
	case src/cmd/*.c src/cmd/*.y
		c=`{basename $f | sed 's/\.[cy]$//'}
		if(! ~ src/cmd/$c.install $cmds)
			cmds=($cmds src/cmd/$c.install)
	}
}
for(l in $libs)
	build $l install || fail build of $l failed
if(! ~ $#all 0){
	# a few commands may fail with -a (e.g., postscript); go on
	build src/cmd -k -a install >$log >[2=1]
	grep -i -e error -e 'mk: ' $log
	echo 9update: full log in $log
}
if not for(c in $cmds){
	switch($c){
	case *.install
		build src/cmd `{basename $c} || fail build of $c failed
	case *
		build $c install || fail build of $c failed
	}
}
echo '9update: done; restart acme and other programs to use the new binaries'
