#!/bin/sh
# p9update [-n] [-s commit] [pr ...] - merge pull requests and bring $PLAN9 up to date.
#
# Merges each pull request given (by number, in the repository of
# origin, with gh), pulls the branch from origin into $PLAN9 (a git
# clone on master), and rebuilds and installs what the pulled commits
# changed:
#	include, src/mk*	everything (cd src; mk -a install)
#	src/lib*	those libraries, then all commands relinked
#			(cd src/cmd; mk -k -a install), as mk does not
#			notice that a library changed
#	src/.../x.c in a dir	built with mkmany: mk x.install there
#	any other file in src	mk install in the nearest dir with a mkfile
# Scripts in bin, man pages, and mac/*.app need no building.
# Files that only differ from git by INSTALL's path rewrite
# (/usr/local/plan9 -> $PLAN9, e.g. the #! lines of scripts) are
# restored before pulling, and the files in lib/moveplan9.files are
# rewritten again after it; any other local change makes it stop.
# With -n, it says what it would do, and does nothing.
# With -s, it also builds what changed since commit (e.g., HEAD~3,
# to redo builds that failed).

PLAN9=${PLAN9:-/usr/local/plan9}
export PLAN9
PATH=$PLAN9/bin:$PATH
export PATH

usage() { echo 'usage: p9update [-n] [-s commit] [pr ...]' >&2; exit 2; }
n=
since=
while :; do
	case $1 in
	-n)
		n=echo
		shift;;
	-s)
		[ $# -ge 2 ] || usage
		since=$2
		shift 2;;
	-*)
		usage;;
	*)
		break;;
	esac
done
for pr in "$@"; do
	case $pr in
	*[!0-9]*|'')
		usage
	esac
done

die() { echo "p9update: $*" >&2; exit 1; }
run() {
	echo "% $*"
	[ -n "$n" ] && return 0
	"$@"
}

cd "$PLAN9" || die "no $PLAN9"
git rev-parse --git-dir >/dev/null 2>&1 || die "$PLAN9 is not a git clone"
br=$(git symbolic-ref --short HEAD 2>/dev/null)
[ "$br" = master ] || die "$PLAN9 is on ${br:-a detached HEAD}, not master"
# local changes must be just INSTALL's path rewrite
rewritten=
for f in $(git diff --name-only HEAD --); do
	if git show "HEAD:$f" 2>/dev/null | /usr/bin/sed "s,/usr/local/plan9,$PLAN9,g" | /usr/bin/cmp -s - "$f"; then
		rewritten="$rewritten $f"
	else
		die "$f has local changes (git diff $f): commit or undo them"
	fi
done

if [ $# -gt 0 ]; then
	command -v gh >/dev/null || die "gh is needed to merge (brew install gh; gh auth login)"
	repo=$(git remote get-url origin | sed -E 's,^(https://github.com/|git@github.com:),,; s,\.git$,,')
	for pr in "$@"; do
		run gh pr merge "$pr" --repo "$repo" --merge --delete-branch || die "cannot merge #$pr"
	done
fi

old=$(git rev-parse HEAD)
[ -n "$rewritten" ] && run git checkout -- $rewritten
run git pull -q --ff-only origin master || die "cannot pull"
new=$(git rev-parse HEAD)
# redo INSTALL's path rewrite, on the files it rewrites
if [ -z "$n" ] && [ "$PLAN9" != /usr/local/plan9 ]; then
	for f in $(cat lib/moveplan9.files) $rewritten; do
		[ -f "$f" ] && grep -q /usr/local/plan9 "$f" || continue
		/usr/bin/sed "s,/usr/local/plan9,$PLAN9,g" "$f" >"$f.p9u" && cat "$f.p9u" >"$f"
		rm -f "$f.p9u"
	done
fi
if [ -n "$n" ]; then
	# what a pull would bring
	git fetch -q origin master && new=$(git rev-parse FETCH_HEAD)
fi
if [ -n "$since" ]; then
	old=$(git rev-parse --verify -q "$since^{commit}") || die "$since: no such commit"
fi
if [ "$old" = "$new" ]; then
	echo "p9update: up to date"
	exit 0
fi
git log --oneline "$old..$new"
changed=$(git diff --name-only "$old" "$new")

# the dir of a file with a mkfile, going up from it (within src)
mkdir_of() {
	d=$(dirname "$1")
	while [ "$d" != . ] && [ "$d" != src ] && [ ! -f "$d/mkfile" ]; do
		d=$(dirname "$d")
	done
	echo "$d"
}

# what to build for a changed file in src. Not inline in the
# $(...) below: bash 3.2 (macOS /bin/sh) takes the ) of a case
# pattern there as the end of the $(.
target_of() {
	d=$(mkdir_of "$1")
	case $d in
	.|src)
		return;;
	esac
	b=$(basename "$1")
	if [ "$(dirname "$1")" = "$d" ] && grep -q 'mkmany' "$d/mkfile"; then
		case $b in
		*.c|*.y|*.lx)
			echo "$d ${b%.*}.install"
			return;;
		esac
		echo "$d many-install"
	else
		echo "$d install"
	fi
}

if echo "$changed" | grep -Eq '^(include/|src/mk)'; then
	targets='src -a install'
elif echo "$changed" | grep -Eq '^src/lib'; then
	targets=$(echo "$changed" | grep '^src/lib' | cut -d/ -f1-2 | sort -u | sed 's/$/ install/'
		echo 'src/cmd -k -a install')
else
	targets=$(echo "$changed" | grep '^src/' | while read -r f; do
		target_of "$f"
	done | sort -u)
fi

status=0
if [ -n "$targets" ]; then
	echo "$targets" | {
		while read -r d t; do
			echo "% cd $d; mk $t"
			[ -n "$n" ] && continue
			(cd "$PLAN9/$d" && mk $t) || { echo "p9update: $d: mk $t failed" >&2; status=1; }
		done
		exit $status
	}
	status=$?
fi
if echo "$changed" | grep -q '^mac/.*\.app/'; then
	echo "p9update: mac apps changed; they run from $PLAN9/mac (restart them to use the new ones)"
fi
exit $status
