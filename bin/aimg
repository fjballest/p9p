#!/usr/local/plan9/bin/rc
# aimg [-s percent] file - show an image in a macme window.
# Zoom+ and Zoom- in the tag scale it (with ImageMagick's convert),
# and Zoom! fits it to the window.
. $PLAN9/lib/acme.rc
ifs=' 	
'
path=($path /opt/local/bin /opt/homebrew/bin /usr/local/bin)

scale=100
if(~ $1 -s){
	scale=$2
	shift 2
}
if(! ~ $#* 1){
	echo 'usage: aimg [-s percent] file' >[1=2]
	exit usage
}
f=$1
if(! ~ $f /*)
	f=`{pwd}^/$f
if(! test -r $f){
	echo aimg: $f: cannot read >[1=2]
	exit open
}

# write the image at $scale% to the window
fn render {
	if(! ~ $scale 100)
		convert $f -resize $scale% png:- | png -t
	if not switch($f){
	case *.png *.PNG
		png -t $f
	case *.jpg *.jpeg *.JPG *.JPEG
		jpg -t $f
	case *.gif *.GIF
		gif -t $f
	case *.bit *.img
		cat $f
	case *
		convert $f png:- | png -t
	}
}

fn show {
	render | winwrite image
	# so Dump and Load bring the window back as it is
	winctl dump aimg -s $scale $f
}

fn event {
	switch($2){
	case x X
		switch($9){
		case Zoom+
			scale=`{expr $scale '*' 5 / 4}
			show
		case Zoom-
			if(! ~ $scale [0-9] 1[0-9]){
				scale=`{expr $scale '*' 4 / 5}
				show
			}
		case Zoom!
			s=`{winread image | awk '{
				if($3 <= 0 || $4 <= 0){ print '$scale'; exit }
				x = $1/$3; y = $2/$4
				s = int('$scale' * ((x < y) ? x : y))
				print (s < 1) ? 1 : s
			}'}
			if(! ~ $s $scale){
				scale=$s
				show
			}
		case *
			winwriteevent $*
		}
	case I
		;	# a click on the image
	case *
		winwriteevent $*
	}
}

newwindow
winname $f
winctl dumpdir /
echo -n ' Zoom+ Zoom- Zoom! ' | winwrite tag
show
winctl clean
wineventloop
